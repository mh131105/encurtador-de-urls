#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export SPECIFY_FEATURE_DIRECTORY=specs/001-encurtador
export SPECIFY_FEATURE_NO_PERSIST=1

case "$#:${1-}" in
    0:) mode=run ;;
    1:--check) mode=info ;;
    *) echo 'Uso: ./.specify/desenvolver [--check]' >&2; exit 2 ;;
esac

bash .specify/scripts/bash/check-prerequisites.sh --json --require-spec --require-tasks --include-tasks
if [ "$mode" = run ] && command -v mise >/dev/null 2>&1; then
    exec mise exec -- specify workflow run desenvolver
fi
exec specify workflow "$mode" desenvolver
