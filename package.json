{
  "name": "encurtador-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/{src,tests}/**/*.test.js\" tests/load/latencias.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "cassandra-driver": "4.10.0",
    "redis": "6.3.1"
  },
  "license": "Apache-2.0"
}
